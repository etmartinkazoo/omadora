# omadora: Fedora Sway Atomic + Quickshell as a bootable container image.
#
# Build:   podman build -f atomic/Containerfile -t omadora .
# Use:     see atomic/README.md (bootstrap.sh, or rpm-ostree rebase / bootc switch)
ARG FEDORA_VERSION=45

# ---- omadora-phone (pure Go: a static binary, no toolchain in the image) ----
# Keep GO_VERSION in step with the `go` line in phone/go.mod.
ARG GO_VERSION=1.27.2
FROM docker.io/library/golang:${GO_VERSION} AS phone
WORKDIR /src
COPY phone/go.mod phone/go.sum ./
RUN go mod download
COPY phone/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /out/omadora-phone ./cmd/omadora-phone

# ---- whisper-cli for dictation, at the commit steps/75-dictation.sh pins ----
# Generic CPU code (the image runs on any x86-64) plus Vulkan for the GPU.
FROM quay.io/fedora/fedora:${FEDORA_VERSION} AS whisper
RUN dnf5 -y install --setopt=install_weak_deps=False \
        git gcc-c++ cmake vulkan-headers vulkan-loader-devel glslc spirv-headers-devel \
    && dnf5 clean all
COPY steps/75-dictation.sh /tmp/75-dictation.sh
RUN set -eu; \
    repo=$(sed -n 's/^WHISPER_REPO="\(.*\)"$/\1/p' /tmp/75-dictation.sh); \
    commit=$(sed -n 's/^WHISPER_COMMIT="\(.*\)"$/\1/p' /tmp/75-dictation.sh); \
    git clone --quiet --filter=blob:none "$repo" /src; \
    git -C /src -c advice.detachedHead=false checkout --quiet "$commit"; \
    cmake -S /src -B /build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
        -DGGML_NATIVE=OFF -DGGML_VULKAN=ON -DWHISPER_BUILD_TESTS=OFF -DWHISPER_BUILD_EXAMPLES=ON; \
    cmake --build /build -j"$(nproc)" --target whisper-cli; \
    install -Dm755 /build/bin/whisper-cli /out/whisper-cli; \
    echo "commit=$commit vulkan=ON" > /out/whisper-build-info

# ---- the OS image ----
FROM quay.io/fedora-ostree-desktops/sway-atomic:${FEDORA_VERSION}

ARG IMAGE_REF=ghcr.io/etmartinkazoo/omadora
ARG IMAGE_VERSION=dev

COPY --from=phone /out/omadora-phone /usr/bin/omadora-phone
COPY --from=whisper /out/whisper-cli /usr/bin/whisper-cli
COPY . /usr/share/omadora
COPY --from=whisper /out/whisper-build-info /usr/share/omadora/whisper-build-info
RUN IMAGE_REF="${IMAGE_REF}" IMAGE_VERSION="${IMAGE_VERSION}" \
        /usr/share/omadora/atomic/build.sh \
    && rm -rf /var/cache/* /var/log/* /tmp/* \
    && bootc container lint
