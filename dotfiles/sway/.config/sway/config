### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

set $term kitty

# Application launcher (wmenu, a dmenu replacement for Wayland)
set $menu qs ipc call launcher open

### Output configuration
# The wallpaper is drawn by the shell and follows the theme, so sway's own
# swaybg is disabled: an `output * bg` line would cover the theme wallpaper
# after every sway reload. To use your own image with every theme:
#   omadora-theme wallpaper ~/Pictures/wallpaper.jpg
swaybg_command -
#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

### Idle configuration
#
# Example configuration:
# Locking goes through omadora-lock: Quickshell's lock screen, waiting until
# the lock is confirmed (so suspend can't race it), with swaylock as fallback.
# `loginctl lock-session` triggers the same path. Fedora's 90-swayidle.conf is
# disabled in config.d.
exec swayidle -w \
  timeout 300 'loginctl lock-session' \
  timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
  before-sleep '~/.local/bin/omadora-lock' \
  lock '~/.local/bin/omadora-lock'
#
# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 300 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.

### Input configuration
#
# Example configuration:
#
input "type:touchpad" {
  dwt enabled
  tap enabled
  middle_emulation enabled
}

# Keyboard layout/options are personal: put them in config.d/80-local.conf, e.g.
#   input "type:keyboard" { xkb_options ctrl:swapcaps }

#
# You can get the names of your inputs by running: swaymsg -t get_inputs
# Read `man 5 sway-input` for more information about this section.

### Key bindings
#
# Each "## Section" heading groups the bindings below it in the keybinds overlay
# (Super+. or Super+/). A "#" comment above a group of bindings describes them;
# without one, the sway command describes itself. omadora keeps vim-style
# H/J/K/L movement; where a key is free, bindings follow Omarchy's, so Omarchy
# muscle memory carries over.

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    floating_modifier $mod normal

## Apps
    # Terminal
    bindsym $mod+Return exec $term

    # Browser
    bindsym $mod+Shift+Return exec firefox
    bindsym $mod+Shift+b exec firefox

    # Editor (Neovim)
    bindsym $mod+Shift+n exec $term nvim

    # App launcher
    bindsym $mod+space exec $menu
    bindsym $mod+d exec $menu

    # Chat: a side conversation for ideas (opencode, free DeepSeek)
    bindsym $mod+a exec qs ipc call chat toggle

    # Ask the chat about the selected text
    bindsym $mod+Shift+a exec qs ipc call chat askSelection

## Shell
    # Keybinds overlay
    bindsym $mod+period exec qs ipc call keybinds toggle
    bindsym $mod+slash exec qs ipc call keybinds toggle

    # Clipboard history
    bindsym $mod+Shift+v exec qs ipc call clipboard toggle
    bindsym $mod+Ctrl+v exec qs ipc call clipboard toggle

    # Phone: texts and calls
    bindsym $mod+p exec qs ipc call phone toggle

    # Dictation: hold to talk, or tap to start and tap again to stop
    bindsym --no-repeat $mod+Shift+d exec ~/.local/bin/omadora-dictate press
    bindsym --release $mod+Shift+d exec ~/.local/bin/omadora-dictate release
    # Dictation on the Copilot key (Shift+Super+F23)
    bindsym --no-repeat $mod+Shift+F23 exec ~/.local/bin/omadora-dictate press
    bindsym --release $mod+Shift+F23 exec ~/.local/bin/omadora-dictate release

    # Notification center
    bindsym $mod+n exec qs ipc call notifications toggle

    # Clear all notifications
    bindsym $mod+Shift+comma exec qs ipc call notifications clear

    # Do not disturb
    bindsym $mod+Ctrl+comma exec qs ipc call notifications toggleDnd

    # Theme picker
    bindsym $mod+Shift+t exec qs ipc call theme picker
    bindsym $mod+Shift+Ctrl+space exec qs ipc call theme picker

    # Next wallpaper
    bindsym $mod+Ctrl+space exec qs ipc call theme bgNext

    # Next desktop mode (tiling / Windows / macOS)
    bindsym $mod+Ctrl+m exec ~/.local/bin/omadora-mode next

    # Audio
    bindsym $mod+Ctrl+a exec qs ipc call audio toggle

    # Bluetooth
    bindsym $mod+Ctrl+b exec qs ipc call bluetooth toggle

    # Network
    bindsym $mod+Ctrl+w exec qs ipc call wifi toggle

    # Displays
    bindsym $mod+Ctrl+d exec qs ipc call displays toggle

    # Night light on/off
    bindsym $mod+Ctrl+n exec qs ipc call nightlight togglePower

    # Keep awake (caffeine)
    bindsym $mod+Ctrl+i exec qs ipc call caffeine toggle

## System
    # Lock
    bindsym $mod+Ctrl+l exec loginctl lock-session

    # Power & session menu
    bindsym $mod+Escape exec qs ipc call power open
    bindsym $mod+Shift+e exec qs ipc call power open
    bindsym $mod+Ctrl+p exec qs ipc call power open

    # Reload sway
    bindsym $mod+Shift+c reload

## Windows
    # Close window
    bindsym $mod+q kill

    # Fullscreen
    bindsym $mod+f fullscreen

    # Toggle floating
    bindsym $mod+t floating toggle
    bindsym $mod+Shift+space floating toggle

    # Pop out (float, show on every workspace)
    bindsym $mod+o floating toggle, sticky toggle

    # Focus the parent container
    bindsym $mod+Alt+a focus parent

    # Snap floating window: halves, then quarters; up maximizes
    bindsym $mod+Alt+Left exec qs ipc call window snap left
    bindsym $mod+Alt+Right exec qs ipc call window snap right
    bindsym $mod+Alt+Up exec qs ipc call window snap up
    bindsym $mod+Alt+Down exec qs ipc call window snap down

    # Switch apps (hold Super, tap Tab, release)
    bindsym $mod+Tab exec qs ipc call switcher apps
    bindsym $mod+Shift+Tab exec qs ipc call switcher appsBack

    # Switch between this app's windows (hold Alt, tap Tab, release)
    bindsym Alt+Tab exec qs ipc call switcher windows
    bindsym Alt+Shift+Tab exec qs ipc call switcher windowsBack

    # Minimize (Super+- brings it back)
    bindsym $mod+m move scratchpad

## Moving around
    # Focus window in direction
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move window in direction
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right

## Workspaces
    # Switch to workspace 1-10
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10

    # Move window to workspace 1-10
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10

    # Next / previous workspace
    bindsym $mod+Ctrl+Right workspace next_on_output
    bindsym $mod+Ctrl+Left workspace prev_on_output

    # Overview: every window at a glance
    bindsym $mod+Ctrl+Up exec qs ipc call overview toggle

    # Back to the last workspace
    bindsym $mod+Ctrl+Tab workspace back_and_forth

    # Move workspace to another monitor
    bindsym $mod+Shift+Alt+Left move workspace to output left
    bindsym $mod+Shift+Alt+Right move workspace to output right
    bindsym $mod+Shift+Alt+Up move workspace to output up
    bindsym $mod+Shift+Alt+Down move workspace to output down

## Layout
    # Split horizontally / vertically
    bindsym $mod+b splith
    bindsym $mod+v splitv

    # Stacked layout
    bindsym $mod+s layout stacking

    # Tabbed layout
    bindsym $mod+w layout tabbed

    # Toggle split direction
    bindsym $mod+e layout toggle split

    # Focus tiling / floating windows
    bindsym $mod+Alt+space focus mode_toggle

    # Resize mode
    bindsym $mod+r mode "resize"

## Scratchpad
    # Show / hide the scratchpad
    bindsym $mod+minus scratchpad show

    # Send window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad

mode "resize" {
    # Shrink / grow width and height
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Leave resize mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# Window borders & gaps (matching Quickshell Theme)
# 2px everywhere; only the focused window's is visible (the theme makes the
# others transparent), since sway can't size borders by focus.
default_border pixel 2
default_floating_border pixel 2
gaps inner 10
gaps outer 0

