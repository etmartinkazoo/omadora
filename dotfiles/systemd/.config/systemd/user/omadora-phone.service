[Unit]
Description=omadora phone: texts (Google Messages) and calls (Bluetooth) for the panel
PartOf=graphical-session.target
After=graphical-session.target pipewire.service wireplumber.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=%h/.local/bin/omadora-phone daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=sway-session.target
