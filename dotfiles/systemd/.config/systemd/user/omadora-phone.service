[Unit]
Description=omadora phone: texts (Google Messages) and calls (Bluetooth) for the panel
PartOf=graphical-session.target
After=graphical-session.target pipewire.service wireplumber.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# A build from a ~/omadora checkout (steps/70-phone.sh) wins over the image's.
ExecSearchPath=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=omadora-phone daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=sway-session.target
