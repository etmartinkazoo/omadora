#!/usr/bin/env bash
# omadora-mode: switch the desktop between tiling, windows and macos modes.
#
#   omadora-mode               print the current mode
#   omadora-mode set MODE      tiling | windows | macos (applies live)
#   omadora-mode next          cycle through the modes
#   omadora-mode list          list the modes
#
# tiling   sway tiles every window; the bar runs along the bottom (the default).
# windows  windows float with title bars; a taskbar runs along the bottom.
# macos    windows float with title bars; a top bar, plus a dock at the bottom.
#
# The mode is stored in ~/.local/state/omadora/mode (Quickshell watches it and
# swaps the bar). Window behavior goes in ~/.config/sway/config.d/50-mode.conf,
# which is generated: don't edit it.
set -euo pipefail

MODES=(tiling windows macos)
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omadora"
SWAY_DROPIN="${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/50-mode.conf"

die() { echo "omadora-mode: $*" >&2; exit 1; }

current() {
    local m
    m=$(cat "$STATE/mode" 2>/dev/null || true)
    for x in "${MODES[@]}"; do [[ $m == "$x" ]] && { echo "$m"; return; }; done
    echo tiling
}

swaymsg_quiet() { swaymsg "$@" >/dev/null 2>&1 || true; }

# Window layouts across mode switches. Leaving a floating mode saves where
# every floating window was; entering one puts them back, and windows that
# have never floated start where they were tiled.
#   layout save              -> floating-layout.json
#   layout tiled             -> print {con_id: frame} of tiled windows (stdout)
#   layout restore TILED     -> print sway commands placing each window
#   layout correct TILED     -> the same, compensating for how far off the
#                               first placement landed (title bars, apps that
#                               size in character cells)
layout() {
    swaymsg -r -t get_tree | python3 -I -c '
import json, sys, os
state, mode = sys.argv[1], sys.argv[2]
saved_path = os.path.join(state, "floating-layout.json")
tree = json.load(sys.stdin)

def windows(node, ws=""):
    if node.get("type") == "workspace":
        ws = node["name"]
    if node.get("pid") and node.get("type") in ("con", "floating_con") and ws != "__i3_scratch":
        yield node
    for c in node.get("nodes", []) + node.get("floating_nodes", []):
        yield from windows(c, ws)

def frame(n):
    r, title = n["rect"], (n.get("deco_rect") or {}).get("height", 0) if n["type"] == "floating_con" else 0
    return {"x": r["x"], "y": r["y"] - title, "width": r["width"], "height": r["height"] + title}

if mode == "save":
    frames = {str(n["id"]): frame(n) for n in windows(tree) if n["type"] == "floating_con"}
    with open(saved_path + ".tmp", "w") as f:
        json.dump(frames, f)
    os.replace(saved_path + ".tmp", saved_path)
elif mode == "tiled":
    print(json.dumps({str(n["id"]): frame(n) for n in windows(tree) if n["type"] == "con"}))
elif mode in ("restore", "correct"):
    try:
        saved = json.load(open(saved_path))
    except (OSError, ValueError):
        saved = {}
    tiled = json.loads(sys.argv[3])
    for n in windows(tree):
        f = saved.get(str(n["id"])) or tiled.get(str(n["id"]))
        if f and n["type"] == "floating_con":
            w, h = f["width"], f["height"]
            if mode == "correct":
                cur = frame(n)
                dw, dh = f["width"] - cur["width"], f["height"] - cur["height"]
                if abs(dw) <= 2 and abs(dh) <= 2 and abs(f["x"] - cur["x"]) <= 2 and abs(f["y"] - cur["y"]) <= 2:
                    continue
                # Ask for the target plus what was missing
                w += dw
                h += dh
            print("[con_id=%d] resize set %d %d, move absolute position %d %d"
                  % (n["id"], w, h, f["x"], f["y"]))
' "$STATE" "$@"
}

apply() {
    local mode=$1
    local prev running=0
    prev=$(current)
    [[ -n ${SWAYSOCK:-} ]] || pgrep -x sway >/dev/null && running=1

    # Measure before anything changes: the shell swaps bars as soon as the
    # mode file changes, and sway re-tiles around the new bar.
    local tiled="{}"
    if ((running)); then
        if [[ $prev != tiling && $mode == tiling ]]; then
            layout save || true
        elif [[ $prev == tiling && $mode != tiling ]]; then
            tiled=$(layout tiled || echo "{}")
        fi
    fi
    mkdir -p "$STATE" "$(dirname "$SWAY_DROPIN")"

    if [[ $mode == tiling ]]; then
        printf '# Generated by omadora-mode (tiling). Do not edit.\n' >"$SWAY_DROPIN.tmp"
    else
        cat >"$SWAY_DROPIN.tmp" <<EOF
# Generated by omadora-mode ($mode). Do not edit.
# Windows float, with title bars, like a classic desktop.
for_window [all] floating enable, border normal 1
default_border normal 1
default_floating_border normal 1
titlebar_padding 8 4
title_align $([[ $mode == macos ]] && echo center || echo left)
# Maximized and snapped windows fill the screen edge to edge
gaps inner 0
gaps outer 0

## Window shortcuts
# These take Alt+letter from apps (e.g. Alt+D in Firefox) in this mode only.

# Maximize / restore
bindsym Alt+m exec qs ipc call window maximize

# Fullscreen
bindsym Alt+f fullscreen toggle

# Show the desktop (again brings the windows back)
bindsym Alt+d exec qs ipc call window showDesktop

# Snap left half
bindsym Alt+a exec qs ipc call window snapTo left

# Snap right half
bindsym Alt+s exec qs ipc call window snapTo right

# Hide the app (all its windows)
bindsym Alt+h exec qs ipc call window hideApp

# Close the window
bindsym Alt+w kill
EOF
    fi
    mv "$SWAY_DROPIN.tmp" "$SWAY_DROPIN"
    echo "$mode" >"$STATE/mode.tmp" && mv "$STATE/mode.tmp" "$STATE/mode"

    if ((running)); then
        swaymsg_quiet reload
        # Bring the windows that are already open into the new mode. Minimized
        # windows (in the scratchpad) are left where they are.
        # Gaps apply to new workspaces on reload; set them on existing ones too.
        if [[ $mode == tiling ]]; then
            swaymsg_quiet '[workspace="^(?!__i3_scratch$)" floating] floating disable, border pixel 1'
            swaymsg_quiet 'gaps inner all set 10, gaps outer all set 0'
        else
            swaymsg_quiet '[workspace="^(?!__i3_scratch$)" tiling] floating enable, border normal 1'
            swaymsg_quiet 'gaps inner all set 0, gaps outer all set 0'
            if [[ $prev == tiling ]]; then
                layout restore "$tiled" | while IFS= read -r cmd; do swaymsg_quiet "$cmd"; done
                # Correct until every window is within 2px (sway applies
                # sizes asynchronously; apps may round them)
                for _ in 1 2 3; do
                    sleep 0.15
                    cmds=$(layout correct "$tiled")
                    [[ -z $cmds ]] && break
                    while IFS= read -r cmd; do swaymsg_quiet "$cmd"; done <<<"$cmds"
                done
            fi
        fi
    fi
}

case "${1:-}" in
    "") current ;;
    list) printf '%s\n' "${MODES[@]}" ;;
    set)
        [[ -n ${2:-} ]] || die "usage: omadora-mode set tiling|windows|macos"
        for x in "${MODES[@]}"; do [[ $2 == "$x" ]] && { apply "$2"; exit 0; }; done
        die "unknown mode '$2' (tiling, windows or macos)"
        ;;
    next)
        cur=$(current)
        for i in "${!MODES[@]}"; do
            if [[ ${MODES[$i]} == "$cur" ]]; then apply "${MODES[$(((i + 1) % ${#MODES[@]}))]}"; exit 0; fi
        done
        ;;
    -h | --help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$1' (see --help)" ;;
esac
