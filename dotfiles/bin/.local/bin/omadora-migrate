#!/usr/bin/env bash
# omadora-migrate: bring your data over from another omadora machine.
#
#   omadora-migrate [--dry-run] [--only GROUPS] [--phone] USER@HOST
#
# Run it on the new machine; it pulls from the old one over SSH (rsync), so
# nothing personal ever goes through the repo or the image. Groups
# (comma-separated for --only; default: all of them):
#
#   omadora   theme, mode, settings, Start menu pins, phone favorites,
#               dictation settings and speech models, 80-local.conf
#   firefox     the Firefox profile (close Firefox on both machines first)
#   keys        ~/.ssh and ~/.gnupg
#
# --phone also moves the Google Messages pairing. A pairing can't be shared,
# so this stops and disables omadora-phone on the old machine. Without it,
# pair the new machine fresh ("Pair Phone" in the launcher).
set -euo pipefail

dry=0 phone=0 only="omadora,firefox,keys" host=""
while [ $# -gt 0 ]; do
    case $1 in
        -n | --dry-run) dry=1 ;;
        --only) only=$2; shift ;;
        --phone) phone=1 ;;
        -h | --help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) echo "omadora-migrate: unknown option $1" >&2; exit 2 ;;
        *) host=$1 ;;
    esac
    shift
done
[ -n "$host" ] || { sed -n '4p' "$0" | sed 's/^# *//' >&2; exit 2; }
want() { case ",$only," in *",$1,"*) return 0 ;; *) return 1 ;; esac; }

# One SSH connection for every step (a single password / key prompt).
sock=$(mktemp -u "${XDG_RUNTIME_DIR:-/tmp}/omadora-migrate.XXXXXX")
ssh -o ControlMaster=yes -o ControlPath="$sock" -o ControlPersist=600 -fN "$host"
trap 'ssh -o ControlPath="$sock" -O exit "$host" 2>/dev/null' EXIT
remote() { ssh -o ControlPath="$sock" "$host" "$@"; }

flags=(-aR --ignore-missing-args -e "ssh -o ControlPath=$sock")
if [ "$dry" = 1 ]; then flags+=(--dry-run -v); else flags+=(--info=progress2); fi
# pull PATH... [-- RSYNC-OPTIONS...]: paths relative to the home folders.
pull() {
    local paths=() opts=()
    while [ $# -gt 0 ] && [ "$1" != -- ]; do paths+=("$host:$1"); shift; done
    [ $# -gt 0 ] && shift && opts=("$@")
    rsync "${flags[@]}" "${opts[@]}" "${paths[@]}" "$HOME/"
}

if want omadora; then
    echo "==> omadora settings"
    # Quickshell writes its settings file whenever they change: keep it from
    # overwriting what comes over. It's restarted at the end.
    [ "$dry" = 1 ] || systemctl --user stop quickshell.service 2>/dev/null || true
    # linked-version and updates.json describe that machine, not this one;
    # backups are that machine's history.
    pull .config/omadora .local/state/omadora .local/state/quickshell \
        .config/sway/config.d/80-local.conf .local/share/omadora/whisper/models \
        -- --exclude=/.local/state/omadora/phone '--exclude=/.local/state/omadora/backup-*' \
        --exclude=/.local/state/omadora/linked-version --exclude=/.local/state/omadora/updates.json
fi

if want firefox; then
    echo "==> Firefox profile"
    if pgrep -x firefox >/dev/null || remote pgrep -x firefox >/dev/null; then
        echo "error: close Firefox on both machines first (or skip it: --only omadora,keys)" >&2
        exit 1
    fi
    pull .config/mozilla .mozilla
fi

if want keys; then
    echo "==> SSH and GPG keys"
    pull .ssh .gnupg -- --exclude=/.ssh/known_hosts.old --exclude='/.gnupg/S.*'
fi

if [ "$phone" = 1 ]; then
    echo "==> Phone pairing (moves it: the old machine stops texting)"
    if [ "$dry" = 0 ]; then
        remote systemctl --user disable --now omadora-phone.service
        systemctl --user stop omadora-phone.service 2>/dev/null || true
    fi
    pull .local/state/omadora/phone
fi

[ "$dry" = 0 ] || { echo "dry run: nothing copied"; exit 0; }
echo "==> Applying"
command -v omadora-theme >/dev/null && omadora-theme refresh >/dev/null || true
systemctl --user restart quickshell.service 2>/dev/null || true
[ "$phone" = 1 ] && systemctl --user start omadora-phone.service 2>/dev/null || true
echo " ok migrated from $host"
