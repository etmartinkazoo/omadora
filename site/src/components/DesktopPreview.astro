---
// A faithful, HTML-rendered preview of the omadora desktop (candor
// theme): two tiled windows, the launcher open as a calculator, and the bar.
// Sized with container query units so it scales cleanly at any width.
---

<figure class="preview" aria-label="Preview of the omadora desktop: tiled terminal and notes windows, the launcher showing a calculation, and the bar along the bottom">
	<div class="screen" aria-hidden="true">
		<div class="tiles">
			<div class="win term focused">
				<div class="title">foot — ~</div>
				<div class="body mono">
					<p><span class="p">$</span> cat /etc/fedora-release</p>
					<p>Fedora release 45 (Forty Five)</p>
					<p><span class="p">$</span> systemctl is-enabled dnf5-automatic.timer</p>
					<p class="ok">enabled</p>
					<p>&nbsp;</p>
					<p><span class="p">$</span> getenforce</p>
					<p class="ok">Enforcing</p>
					<p><span class="p">$</span> <span class="cursor"></span></p>
				</div>
			</div>
			<div class="stack">
				<div class="win">
					<div class="title">Q4 plan.md</div>
					<div class="body">
						<p class="h">Q4 plan</p>
						<p class="line w90"></p>
						<p class="line w70"></p>
						<p class="line w80"></p>
						<p class="line w50"></p>
					</div>
				</div>
				<div class="win">
					<div class="title">Inbox</div>
					<div class="body">
						<p class="row"><span class="dot"></span><span class="line w60"></span></p>
						<p class="row"><span class="dot dim"></span><span class="line w80"></span></p>
						<p class="row"><span class="dot dim"></span><span class="line w50"></span></p>
					</div>
				</div>
			</div>
		</div>

		<div class="launcher">
			<div class="search mono">= 1240 * 1.0825</div>
			<div class="result mono"><span class="ico">󰃬</span><b>1342.3</b><span class="hint">Enter to copy</span></div>
			<div class="apps">
				<div class="app"><span class="ico">󰈹</span>Firefox <span class="dim">Web Browser</span></div>
				<div class="app"><span class="ico"></span>Foot <span class="dim">Terminal</span></div>
				<div class="app"><span class="ico">󰉋</span>Files <span class="dim">File Manager</span></div>
			</div>
		</div>

		<div class="bar mono">
			<div class="group">
				<span class="pill">LAUNCH</span>
				<span class="pill sel">1</span><span class="pill">2</span><span class="pill">3</span>
				<span class="pill wide">󰏤 Focus Mix</span>
			</div>
			<span class="clock">Mon, Oct 19 - 9:41am</span>
			<div class="group">
				<span class="pill">󰒓</span>
				<span class="pill wide">󰕾 40%</span>
				<span class="pill">󰤨</span>
				<span class="pill hide-sm">󰂯</span>
				<span class="pill">󰂚</span>
				<span class="pill wide">󰁹 92%  ⏻</span>
			</div>
		</div>
	</div>
</figure>

<style>
	.preview {
		margin: 0;
		container-type: inline-size;
		filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.55));
	}
	.screen {
		--panel: #141d2b;
		--item: #0d1420;
		--sel: #1f3d6e;
		--bd: #385a94;
		--bd2: #1f2e47;
		--tx: #f0f5ff;
		--tx2: #8fa8cc;
		--tx3: #566b8c;
		position: relative;
		aspect-ratio: 16 / 10;
		border: 1px solid #2a3c5c;
		border-radius: 1.6cqw;
		overflow: hidden;
		background:
			radial-gradient(ellipse at 80% 10%, #1d3459 0%, transparent 55%),
			radial-gradient(ellipse at 10% 90%, #13233d 0%, transparent 50%),
			#070b12;
		font-size: 1.45cqw;
		color: var(--tx);
	}
	.mono,
	.ico {
		font-family: var(--font-mono);
	}
	.tiles {
		position: absolute;
		inset: 1.8cqw 1.8cqw 6.2cqw;
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		gap: 1.2cqw;
	}
	.stack {
		display: grid;
		grid-template-rows: 1.3fr 1fr;
		gap: 1.2cqw;
		min-height: 0;
	}
	.win {
		background: var(--item);
		border: 1px solid var(--bd2);
		display: flex;
		flex-direction: column;
		min-height: 0;
		overflow: hidden;
	}
	.win.focused {
		border-color: var(--bd);
	}
	.title {
		background: var(--panel);
		color: var(--tx2);
		padding: 0.5cqw 1cqw;
		font-family: var(--font-mono);
		font-size: 0.85em;
		border-bottom: 1px solid var(--bd2);
	}
	.body {
		padding: 1cqw 1.2cqw;
		line-height: 1.55;
	}
	.body p {
		margin: 0;
		white-space: nowrap;
	}
	.term .body {
		font-size: 0.92em;
	}
	.p {
		color: #6f9cf2;
	}
	.dim {
		color: var(--tx3);
	}
	.ok {
		color: #5fd08a;
	}
	.cursor {
		display: inline-block;
		width: 0.6em;
		height: 1.05em;
		vertical-align: -0.15em;
		background: var(--tx);
		animation: blink 1.1s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	.h {
		font-family: var(--font-mono);
		font-weight: 700;
		margin-bottom: 0.8cqw !important;
	}
	.line {
		display: block;
		height: 0.55cqw;
		border-radius: 0.3cqw;
		background: #22324d;
		margin: 0.9cqw 0 !important;
	}
	.row {
		display: flex;
		align-items: center;
		gap: 0.8cqw;
	}
	.row .line {
		flex: none;
		margin: 0.7cqw 0 !important;
	}
	.dot {
		width: 0.7cqw;
		height: 0.7cqw;
		border-radius: 50%;
		background: #6f9cf2;
		flex: none;
	}
	.dot.dim {
		background: #22324d;
	}
	.w90 { width: 90%; }
	.w80 { width: 80%; }
	.w70 { width: 70%; }
	.w60 { width: 60%; }
	.w50 { width: 50%; }

	.launcher {
		position: absolute;
		left: 50%;
		top: 46%;
		transform: translate(-50%, -50%);
		width: 46%;
		background: var(--panel);
		border: 1px solid var(--bd);
		padding: 1.1cqw;
		display: grid;
		gap: 0.6cqw;
		box-shadow: 0 1.5cqw 4cqw rgba(0, 0, 0, 0.6);
	}
	.search {
		background: var(--item);
		border: 1px solid var(--bd);
		padding: 0.9cqw 1.1cqw;
		font-size: 1.05em;
	}
	.result {
		display: flex;
		align-items: center;
		gap: 0.9cqw;
		background: var(--sel);
		border: 1px solid var(--bd);
		padding: 0.8cqw 1.1cqw;
	}
	.result b {
		font-size: 1.15em;
	}
	.hint {
		margin-left: auto;
		color: var(--tx2);
		font-size: 0.8em;
	}
	.apps {
		display: grid;
		gap: 0.3cqw;
	}
	.app {
		display: flex;
		align-items: center;
		gap: 0.9cqw;
		background: var(--item);
		padding: 0.6cqw 1.1cqw;
		font-size: 0.92em;
	}
	.app .dim {
		font-size: 0.85em;
	}
	.ico {
		color: #a9c4ff;
		width: 1.2em;
		text-align: center;
	}

	.bar {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 4.4cqw;
		background: var(--panel);
		border-top: 1px solid var(--bd);
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 1cqw;
		font-size: 0.78em;
		gap: 0.6cqw;
	}
	.group {
		display: flex;
		gap: 0.45cqw;
		align-items: center;
	}
	.pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 2.2cqw;
		height: 2.8cqw;
		padding: 0 0.5cqw;
		background: var(--item);
		border: 1px solid var(--bd);
		white-space: pre;
	}
	.pill.sel {
		background: var(--sel);
	}
	.pill.wide {
		padding: 0 0.8cqw;
	}
	.clock {
		white-space: nowrap;
	}
	@container (max-width: 520px) {
		.hide-sm {
			display: none;
		}
	}
</style>
